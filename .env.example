# Law Simulator Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env with real credentials to version control

# Google Generative AI API Key
# Get from: https://makersuite.google.com/app/apikey
GENAI_KEY=your_genai_key_here

# MongoDB Connection URI
# Example: mongodb+srv://username:password@cluster.mongodb.net/database
MONGO_URI=your_mongo_uri_here

# Flask Secret Key - Generate a random strong key
# Python: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your_random_secret_key_here

# Flask environment (development or production)
FLASK_ENV=development

# Server configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=5000

# Session timeout in minutes
SESSION_TIMEOUT_MINUTES=30

# Enable debug mode (NEVER in production)
FLASK_DEBUG=False
